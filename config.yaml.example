mqtt:
  host: mosquitto
  port: 1883
  topic_prefix: openwrt-presence
  # username: optional
  # password: optional

nodes:
  ap-garden:
    room: garden
    exit: true    # departure timer starts when device disappears from exit nodes
  ap-office:
    room: office
  ap-bedroom:
    room: bedroom
    # token: "<openssl rand -hex 32>"   # enables AP push events for this node
    # url: http://192.168.1.50:9100/metrics   # override if no DNS or custom port
  ap-livingroom:
    room: livingroom
  ap-kitchen:
    room: kitchen
  ap-laundry:
    room: laundry_room

departure_timeout: 120  # seconds — for exit nodes (person walked out)
away_timeout: 64800      # seconds (18h) — safety net for interior nodes (phone dozed)
poll_interval: 5         # seconds between AP scrapes
exporter_port: 9100      # default prometheus-node-exporter-lua port
dns_cache_ttl: 300       # seconds to cache DNS resolutions (0 to disable)
# event_port: 8099       # listen for AP push events (POST /event); needs >=1 node token
# event_hold: 10         # seconds a pushed assoc wins over the scrape

people:
  alice:
    macs:
      - "AA:BB:CC:DD:EE:01"
      - "AA:BB:CC:DD:EE:02"
  bob:
    macs:
      - "AA:BB:CC:DD:EE:03"
